import std.collections.HashMap;
import std.lang.Option;

enum LexPattern {
    Literal(string),
    Regex(string),
}

class LexRule(name:       string, pattern:    LexPattern, skip:       bool, next_state: Option<string>, action:     Option<string>)

class LexState(name:  string, rules: [LexRule])

class LexerDef(states: Map<LexState>)
