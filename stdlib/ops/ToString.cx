trait ToString {
    fn to_string(self) -> string;
}

fn int_to_string(n: int) -> string {
    if (n == 0) { return "0"; }
    var rest = n;
    var negative = n < 0;
    if (negative) { rest = 0 - n; }
    var digits = "0123456789";
    var out = "";
    while (rest > 0) {
        out = str(digits[rest % 10]) + out;
        rest = rest / 10;
    }
    if (negative) { out = "-" + out; }
    return out;
}

impl ToString for int {
    fn to_string(self) -> string { return int_to_string(self); }
}

impl ToString for bool {
    fn to_string(self) -> string {
        if (self) { return "true"; }
        return "false";
    }
}

impl ToString for string {
    fn to_string(self) -> string { return self; }
}
