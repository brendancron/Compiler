trait Named {
    fn type_name(): String;

    meta fn derive(T) {
        gen fn type_name(): String {
            return T.name;
        }
    }
}

class Dog(age: Int)
class Cat(lives: Int)

derive Named for Dog;
derive Named for Cat;

var d = Dog(3);
var c = Cat(9);

print(d.type_name());
print(c.type_name());
