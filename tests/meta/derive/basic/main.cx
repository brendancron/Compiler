trait Named {
    fn type_name(self): string;
}

type Dog { age: int }
type Cat { lives: int }

meta fn derive(shape: TypeShape) for Named {
    match shape {
        TypeShape::Product(t, fields) => {
            var label = str(t);
            gen impl Named for t {
                fn type_name(self): string { return label; }
            }
        }
        TypeShape::Sum(t, variants) => {}
        TypeShape::Scalar => {}
        TypeShape::Other => {}
    }
}

derive Named for Dog;
derive Named for Cat;

var dog = new Dog { age: 3 };
var cat = new Cat { lives: 9 };
print(dog.type_name());
print(cat.type_name());
