// The receiver's type is settled by the function that takes it, so a literal
// with no annotation still finds one.
fn each(items: List<int>, f: (int) -> int) -> List<int> {
    var out: List<int> = [];
    for (v in items) { out.push(f(v)); }
    return out;
}

fn total(items: List<int>) -> int {
    var sum = 0;
    for (v in items) { sum = sum + v; }
    return sum;
}

var nums = [1, 2, 3];
print(nums.each() { it * 2 }.total());
print(nums.each((v) => v + 1).total());
