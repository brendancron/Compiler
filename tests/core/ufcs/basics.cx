// A dot is a call with the receiver passed first.
type Dog { name: string, age: int }

fn describe(d: Dog) -> string { return d.name; }
fn older(d: Dog, by: int) -> Dog { return new Dog { name: d.name, age: d.age + by }; }

var rex = new Dog { name: "rex", age: 3 };
print(rex.describe(), describe(rex));
print(rex.older(2).age, older(rex, 2).age);

fn doubled(n: int) -> int { return n * 2; }
print(3.doubled(), (1 + 2).doubled());

fn shout(text: string) -> string { return text + "!"; }
print("hi".shout().shout());
