var xs = [1, 2, 3];
xs[0] = 9;
print(str(xs[0]) + " " + str(xs[2]));
print(typeof(xs).name);

var grid = [[1, 2], [3, 4]];
grid[0][1] = 7;
print(str(grid[0][1]) + " " + str(grid[1][0]));
print(typeof(grid).name);

var names: Array<string> = ["a", "b"];
print(str(names[1]) + " " + str(typeof(names).name));

fn first(a: Array<int>) -> int { return a[0]; }
print(str(first(xs)) + " " + str(typeof(first).name));
