type Ring<T> {
    items: Array<T>,
    head: int
}

op []<T>(items: Array<T>) -> Ring<T> {
    return new Ring { items: items, head: 0 };
}

op []<T>(r: Ring<T>, i: int) -> T {
    var at = r.head + i;
    while (at >= r.items.len()) {
        at = at - r.items.len();
    }
    return r.items[at];
}

op []=<T>(r: Ring<T>, i: int, v: T) -> T {
    var at = r.head + i;
    while (at >= r.items.len()) {
        at = at - r.items.len();
    }
    r.items[at] = v;
    return v;
}

var ring: Ring<int> = [1, 2, 3];
print(str(ring[0]) + " " + str(ring[1]) + " " + str(ring[4]));

ring.head = 1;
print(str(ring[0]) + " " + str(ring[2]));

ring[0] = 9;
print(str(ring[0]) + " " + str(typeof(ring).name));

var words: Ring<string> = ["a", "b"];
print(str(words[3]) + " " + str(typeof(words).name));

var also: List<int> = [7, 8];
print(str(also.len()) + " " + str(also[1]) + " " + str(ring[0]));
