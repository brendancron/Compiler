var ages: Map<string, int> = [("alice", 30), ("bob", 25)];

ages.insert("carol", 41);

print(ages.len(), typeof(ages).name);
print(ages.contains("alice"), ages.contains("dave"));
print(ages.get_or("bob", 0), ages.get_or("dave", -1));

ages.insert("bob", 26);
print(ages.len(), ages.get_or("bob", 0));

var counts: Map<char, int> = [('a', 2), ('b', 5)];
print(counts.get_or('b', 0));

var empty: Map<string, bool> = [];
print(empty.len(), empty.contains("x"));
