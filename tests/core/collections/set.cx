var seen: Set<int> = [1, 2, 2, 3];

seen.insert(4);
seen.insert(2);

print(seen.contains(2));
print(seen.contains(9));
print(seen.len());

var words: Set<string> = ["a", "b", "a"];
print(words.len(), words.contains("b"), typeof(words).name);

var letters: Set<char> = ['x', 'y', 'x'];
print(letters.len(), letters.contains('y'));

var empty: Set<int> = [];
print(empty.len(), empty.contains(1));
empty.insert(7);
print(empty.len(), empty.contains(7));
