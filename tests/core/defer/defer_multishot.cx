// A handler that resumes twice leaves the scope twice, so what was deferred
// once inside it runs once per exit.
effect Logic { ctl choose(options: Array<int>): int; }

fn pick(): int {
    defer print("cleanup");
    var n = choose([1, 2]);
    print("saw " + str(n));
    return n;
}

run { print(pick()); }
handle Logic { ctl choose(options) { for (x in options) { resume x; } } }
