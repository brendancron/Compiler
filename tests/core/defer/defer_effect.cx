// However the block is left, including an aborting handler unwinding through
// it. The arm runs where the operation was performed, and the unwind — and so
// the deferred statement — comes after it.
effect Error { final ctl throw(msg: string); }

fn risky(bad: bool): int {
    defer print("cleanup");
    if (bad) { return throw("failed"); }
    return 1;
}

run { print(risky(false)); } handle Error { final ctl throw(m) { print("caught" + " " + str(m)); } }
run { print(risky(true)); } handle Error { final ctl throw(m) { print("caught" + " " + str(m)); } }
