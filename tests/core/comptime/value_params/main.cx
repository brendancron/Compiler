// A comptime parameter with a type annotation is a value, written at the call.
// The specialized copy has no such parameter: the value is part of the code.

fn labelled<label: string>(x: int) -> int {
    print(label + ": " + str(x));
    return x;
}

fn size<n: int>() {
    print(n);
}

// One copy per distinct argument, so the two 4s share one and 9 gets its own.
size<4>();
size<9>();
size<4>();

print(labelled<"count">(3));
print(labelled<"total">(7));

// A comptime parameter is itself comptime, so it can be passed straight on.
fn prefixed<prefix: string>(x: int) -> string {
    return prefix + str(x);
}

fn outer<tag: string>(x: int) -> string {
    return prefixed<tag>(x);
}

print(outer<"tag ">(9));
