type Option<T> { Some(T), None }

type Box<T> {
    value: T
}

impl Box<T> {
    fn get(self) -> T {
        return self.value;
    }
}

fn identity<T>(x: T) -> T {
    return x;
}

var some_int = new Option::Some(3);
var some_str = new Option::Some("hi");
var nothing: Option<bool> = new Option::None;

match some_int {
    Option::Some(n) => { print(n); }
    Option::None    => { print("none"); }
}

match some_str {
    Option::Some(s) => { print(s); }
    Option::None    => { print("none"); }
}

match nothing {
    Option::Some(b) => { print(b); }
    Option::None    => { print("none"); }
}

print(typeof(some_int));
print(typeof(some_str));

var boxed = new Box { value: 7 };
print(boxed.get());
print(typeof(boxed));

// Written out where there is nothing to recover them from.
print(identity<int>(5));
print(identity<string>("x"));
