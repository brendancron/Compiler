trait Describe {
    fn describe(): String;
}

class Circle(radius: Int)

class Rectangle(width: Int, height: Int)

impl Describe for Circle {
    fn describe(): String {
        return "circle with radius " + to_string(this.radius);
    }
}

impl Describe for Rectangle {
    fn describe(): String {
        return "rectangle " + to_string(this.width) + "x" + to_string(this.height);
    }
}

var c = Circle(5);
var r = Rectangle(3, 4);

print(c.describe());
print(r.describe());
