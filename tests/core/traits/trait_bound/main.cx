trait Summary {
    fn summarize(): String;
}

class Article(title: String, author: String)

class Tweet(username: String, content: String)

impl Summary for Article {
    fn summarize(): String {
        return this.title + " by " + this.author;
    }
}

impl Summary for Tweet {
    fn summarize(): String {
        return this.username + ": " + this.content;
    }
}

fn notify(item) {
    print("Breaking news: " + item.summarize());
}

var a = Article("Cronyx 0.1.4", "brendancron");
var t = Tweet("cronyx_lang", "traits are here");

notify(a);
notify(t);
