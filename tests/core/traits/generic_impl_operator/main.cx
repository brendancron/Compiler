type Vec2 { x: int, y: int }

op +(a: Vec2, b: Vec2) -> Vec2 {
    return new Vec2 { x: a.x + b.x, y: a.y + b.y };
}

op ==(a: Vec2, b: Vec2) -> bool {
    return a.x == b.x && a.y == b.y;
}

type Pair<T> { a: T, b: T }

impl Pair<T> {
    fn total(self) -> T {
        return self.a + self.b;
    }

    fn twice(self) -> T {
        return self.total() + self.total();
    }

    fn same(self) -> bool {
        return self.a == self.b;
    }
}

var v = new Pair { a: new Vec2 { x: 1, y: 2 }, b: new Vec2 { x: 10, y: 20 } };
print(str(v.total().x) + " " + str(v.twice().x) + " " + str(v.same()));

var n = new Pair { a: 2, b: 3 };
print(str(n.total()) + " " + str(n.twice()) + " " + str(n.same()));

var s = new Pair { a: "ab", b: "ab" };
print(str(s.total()) + " " + str(s.same()));
