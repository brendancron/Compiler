trait Show {
    fn show(): String;
}

class Point(x: Int, y: Int)

class Color(r: Int, g: Int, b: Int)

impl Show for Point {
    fn show(): String {
        return "(" + to_string(this.x) + ", " + to_string(this.y) + ")";
    }
}

impl Show for Color {
    fn show(): String {
        return "rgb(" + to_string(this.r) + ", " + to_string(this.g) + ", " + to_string(this.b) + ")";
    }
}

var p = Point(1, 2);
var c = Color(255, 128, 0);

print(p.show());
print(c.show());
