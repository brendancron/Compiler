type Vec2 { x: int, y: int }

impl Add<Vec2> for Vec2 {
    type Output = Vec2;

    fn add(self, rhs: Vec2): Vec2 {
        return new Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

fn double(x) {
    return x + x;
}

print(double(21));
print(double("ab"));
print(double(new Vec2 { x: 1, y: 2 }).y);
