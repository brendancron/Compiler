var p = { x: 1, y: 2 };
print(p.x, p.y);
p.x = 9;
print(p.x, typeof(p));

// A field read unifies against an open row, so this accepts any record
// that has a `name`.
fn name_of(r) { return r.name; }
print(name_of({ name: "Alice", age: 30 }));
print(name_of({ name: "Bob", city: "Oslo" }));

// Records have identity, like arrays.
var q = p;
q.y = 77;
print(p.y);
