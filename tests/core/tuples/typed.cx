var t: (int, string) = (1, "a");
print(t.0, t.1);

fn swap(p: (int, string)) -> (string, int) { return (p.1, p.0); }
var s = swap(t);
print(s.0, s.1);
print(typeof(swap).name);

var pairs = [(1, "a"), (2, "b")];
print(pairs[1].1, typeof(pairs).name);

// Tuples compare by their elements, unlike arrays.
print((1, 2) == (1, 2));
