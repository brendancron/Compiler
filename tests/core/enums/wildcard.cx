type Color {
    Red,
    Green,
    Blue
}

match new Color::Red {
    Color::Red => { print("red"); }
    _ => { print("other"); }
}

match new Color::Green {
    Color::Red => { print("red"); }
    _ => { print("other"); }
}

match new Color::Blue {
    Color::Red => { print("red"); }
    _ => { print("other"); }
}
