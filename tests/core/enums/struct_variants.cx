enum CardEffect {
    Damage(amount: Int),
    Heal(amount: Int),
    Draw(count: Int),
    None,
}

var dmg  = CardEffect::Damage(15);
var heal = CardEffect::Heal(5);
var draw = CardEffect::Draw(3);
var none = CardEffect::None;

match dmg {
    CardEffect::Damage(amount) => { print(amount); },
    CardEffect::Heal(amount)   => { print(amount); },
    CardEffect::Draw(count)    => { print(count);  },
    CardEffect::None           => { print("none"); },
}

match heal {
    CardEffect::Damage(amount) => { print(amount); },
    CardEffect::Heal(amount)   => { print(amount); },
    CardEffect::Draw(count)    => { print(count);  },
    CardEffect::None           => { print("none"); },
}

match draw {
    CardEffect::Damage(amount) => { print(amount); },
    CardEffect::Heal(amount)   => { print(amount); },
    CardEffect::Draw(count)    => { print(count);  },
    CardEffect::None           => { print("none"); },
}

match none {
    CardEffect::Damage(amount) => { print(amount); },
    CardEffect::Heal(amount)   => { print(amount); },
    CardEffect::Draw(count)    => { print(count);  },
    CardEffect::None           => { print("none"); },
}
