import "../../../stdlib/ops/ToString";

print(0.to_string());
print(42.to_string());
print((-7).to_string());
print(true.to_string());
print(false.to_string());
print("hello".to_string());

class Point(x: Int, y: Int)

impl ToString for Point {
    fn to_string(): String {
        return "(" + this.x.to_string() + ", " + this.y.to_string() + ")";
    }
}

var p = Point(3, 4);
print(p.to_string());
