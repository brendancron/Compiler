import { map, filter, fold } from "../../../stdlib/collections/List";

effect log {
    fn emit(msg: string): unit;
}

fn doubled(x: int): <log> int {
    emit("doubling " + str(x));
    return x * 2;
}

fn big(x: int): <log> bool {
    emit("testing " + str(x));
    return x > 2;
}

run {
    var out = map([1, 2, 3], doubled);
    print(str(out[0]) + " " + str(out[1]) + " " + str(out[2]));

    var kept = filter([1, 2, 3], big);
    print(str(kept.len()));

    print(str(fold([1, 2, 3], 0, (acc, x) => { return acc + x; })));
} handle log {
    fn emit(msg) { print("log: " + msg); }
}
