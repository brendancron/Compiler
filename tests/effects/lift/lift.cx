effect E {
    ctl op(): Int;
}

handler Double : E {
    ctl op() { resume 21; }
    return(v) { v * 2 }
}

handler Tag : E {
    ctl op() { resume 7; }
    return(v) { "got " + to_string(v) }
}

var n = run {
    var a = op();
    var b = op();
    a + b
} handle Double;

var s = run {
    op()
} handle Tag;

print(n);
print(s);
