effect Counter {
    ctl bump(): Int;
}

effect Reader {
    ctl ask(): Int;
}

handler ConstCounter : Counter {
    ctl bump() { resume 1; }
    return(v) { v }
}

handler Ten : Reader {
    ctl ask() { resume 10; }
    return(v) { "ten=" + to_string(v) }
}

var n = run {
    bump() + bump() + bump()
} handle ConstCounter;

var s = run {
    var a = ask();
    var b = ask();
    a * b
} handle Ten;

print(n);
print(s);
