effect async {
    ctl suspend<T>(setup: ((T) -> unit) -> unit): T;
}

var ready: List<() -> unit> = [];

fn main(): <async> unit {
    var n = suspend((wake) => { ready.push { wake(1); }; });
    print("got " + str(n));
    var word = suspend((wake) => { ready.push { wake("hi"); }; });
    print("got " + word);
}

run {
    main();
} handle async {
    ctl suspend(setup) { setup((value) => { print(str(value + 0)); resume value; }); }
}
