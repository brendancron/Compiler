effect task { fn yield(): unit; }

fn work(items: Array<int>): <task> int {
    var total = 0;
    for (i in items) {
        yield();
        total = total + i;
    }
    return total;
}

run {
    print(work([1, 2, 3]));
} handle task {
    ctl yield() {
        resume;
        print("after");
    }
}
