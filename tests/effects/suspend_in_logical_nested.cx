// Every operand suspends and the handler resumes twice, so the split is
// re-entered on each resumption. The four answers are the whole tree: a false
// left in `&&` and a true left in `||` never reach the operand on the right.
effect Flip { ctl flip(): bool; }

fn choose(): <Flip> string {
    if (flip() && (flip() || flip())) { return "yes"; }
    return "no";
}

run {
    print(choose());
} handle Flip {
    ctl flip() {
        resume true;
        resume false;
    }
}
