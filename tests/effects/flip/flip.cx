effect Flip {
    ctl flip(): Bool;
}

print("I'm thirsty");
run {
    var wants_tea = flip();
    var wants_coffee = flip();
    if (wants_tea) {
        print("I'm having oolong");
    } else if (wants_coffee) {
        print("I'm having espresso");
    } else {
        print("I'm having water");
    }
} handle Flip {
    ctl flip() {
        resume false;
        resume true;
    }
}
print("I'm quenched")
