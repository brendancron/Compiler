effect Log {
    fn log(msg: String): Unit;
}

fn greet(name: String): Unit {
    log("Hello, " + name);
}

run {
    greet("Alice");
    greet("Bob");
    greet("Charlie");
} handle Log {
    fn log(msg) {
        print(msg);
    }
}

run {
    greet("Alice");
    greet("Bob");
    greet("Charlie");
} handle Log {
    fn log(msg) {
        print("[Log] " + msg);
    }
}
