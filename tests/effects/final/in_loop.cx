// A `final ctl` needs no continuation, only a way out, so it reaches places a
// resuming handler cannot: inside a loop, and inside a function value.
effect Error { final ctl throw(msg: string); }

fn sum_positive(items: Array<int>) -> int {
    var total = 0;
    for (v in items) {
        if (v < 0) { return throw("negative"); }
        total = total + v;
    }
    return total;
}

fn apply(g: (int) -> <Error> int, v: int) -> <Error> int { return g(v); }

run { print(sum_positive([1, 2, 3])); } handle Error {
    final ctl throw(m) { print("caught: " + m); }
}
run { print(sum_positive([1, 0 - 2, 3])); print("unreachable"); } handle Error {
    final ctl throw(m) { print("caught: " + m); }
}
run {
    print(apply((n) => { if (n < 0) { return throw("negative"); } return n * 2; }, 5));
} handle Error {
    final ctl throw(m) { print("caught: " + m); }
}
