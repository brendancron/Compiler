effect stream {
    ctl yield(value: int): unit;
}

fn range(low: int, high: int) {
    var i = low;
    while (i < high) {
        yield(i);
        i = i + 1;
    }
}

run {
    range(0, 3);
} handle stream {
    ctl yield(value) { print(value); resume; }
}

var first = run { range(100, 103) } handle stream {
    ctl yield(value) { return value; }
} return (nothing) { -1 };

print(first);
