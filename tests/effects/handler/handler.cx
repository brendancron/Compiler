effect Log {
    fn log(msg: String): Unit;
}

fn greet(name: String): Unit {
    log("Hello, " + name);
}

handler LogHandler(prefix: String) : Log {
    fn log(msg: String) {
        print(prefix + msg);
    }
}

run {
    greet("Alice");
    greet("Bob");
    greet("Charlie");
} handle LogHandler("[Log] ");
