// A handler that resumes twice runs the block's body twice — and what follows
// the block once, after the handler is done.
effect logic { ctl choose(options: Array<int>): int; }

fn pick() -> int {
    run {
        var n = choose([1, 2]);
        print("saw" + " " + str(n));
    } handle logic {
        ctl choose(options) { for (x in options) { resume x; } }
    }
    return 7;
}

print(pick());

run {
    var a = choose([1, 2]);
    run {
        var b = choose([10, 20]);
        print(str(a) + " " + str(b));
    } handle logic { ctl choose(o) { for (x in o) { resume x; } } }
} handle logic { ctl choose(o) { for (x in o) { resume x; } } }
print("done");
