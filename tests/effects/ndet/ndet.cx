effect ndet {
    ctl choose(opt: [Int]): Int
    ctl guard(cond: Bool): Bool
}

run {
    var x = choose([1,2,3,4,5]);
    var y = choose([3,5,7]);
    guard(x == y);
    print(x);
} handle ndet {
    ctl choose(items) {
        for(item in items) {
            resume item;
        }
    }

    ctl guard(cond) {
        if (cond) {
            resume;
        }
    }
}
