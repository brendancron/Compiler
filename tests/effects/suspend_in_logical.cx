// `&&` and `||` do not evaluate their right operand unconditionally, so an
// operation there suspends only on the branch that reaches it: `short` performs
// nothing at all.
effect Ask { ctl get(): bool; }

fn any(): <Ask> bool {
    return false || get();
}

fn both(): <Ask> bool {
    return true && get();
}

fn short(): <Ask> bool {
    return true || get();
}

run {
    print(any());
    print(both());
    print(short());
} handle Ask {
    ctl get() {
        resume true;
        print("after");
    }
}
