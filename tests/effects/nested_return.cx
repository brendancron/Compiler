// A `return` inside a branch of a converted function still reaches the
// continuation: it leaves the function, where the join only resumes the rest
// of the body.
effect E { ctl ask(): int; }

fn pick(n: int): int {
    if (n == 0) { return 42; }
    return ask();
}

run {
    print(pick(0));
    print(pick(1));
} handle E {
    ctl ask() { print("asked"); resume 7; }
}
