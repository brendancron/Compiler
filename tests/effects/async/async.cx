effect sched {
    ctl tick(): unit;
}

var queue: List<() -> <sched> unit> = [];

fn counter(name: string) -> <sched> unit {
    for (var i = 0; i < 10; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

fn step(task: () -> <sched> unit) {
    run {
        task();
    } handle sched {
        ctl tick() { queue.push(() => { resume; }); }
    }
}

queue.push(() => { counter("A"); });
queue.push(() => { counter("B"); });

while (queue.len() > 0) {
    var next = queue[0];
    queue = queue[1:];
    step(next);
}
