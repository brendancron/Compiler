effect Async {
    ctl await(): Unit;
}

class AsyncHandler(loop: EventLoop) : Async {
    ctl await(): Unit {
        loop.spawn { resume; };
    }
}

class EventLoop {
    var queue = [];

    fn spawn(thunk) {
        queue += thunk;
    }

    fn run() {
        var loop_handler = AsyncHandler();
        while (queue.len() > 0) {
            var task = queue.remove(0);
            run {
                task();
            } handle loop_handler;
        }
    }
}

fn counter(name: String, n: Int) {
    for (var i = 0; i < n; i += 1) {
        print(name + ": " + to_string(i));
        await();
    }
}

var event_loop = EventLoop();
event_loop.spawn { counter("A", 3); };
event_loop.spawn { counter("B", 3); };
event_loop.run();
