effect async {
    ctl suspend<T>(setup: ((T) -> unit) -> unit): T;
}

fn pause() -> <async> unit {
    return suspend { it(()) };
}

fn interleaved(actions: List<() -> <async> unit>) {
    var ready: List<() -> unit> = [];

    fn strand(action: () -> <async> unit) {
        run {
            action();
        } handle async {
            ctl suspend(setup) {
                setup {
                    ready.push { resume it; };
                };
            }
        }
    }

    for (action in actions) {
        ready.push { strand(action); };
    }

    while (ready.len() > 0) {
        var next = ready[0];
        ready = ready[1:];
        next();
    }
}

fn counter(name: string) -> <async> unit {
    for (var i = 0; i < 10; i += 1) {
        print(name + ": " + str(i));
        pause();
    }
}

interleaved([
    () => { counter("A"); },
    () => { counter("B"); }
]);
