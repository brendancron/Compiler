effect sched {
    ctl tick(): unit;
}

var pending: List<() -> unit> = [];

fn counter(name: string) -> <sched> unit {
    for (var i = 0; i < 10; i += 1) {
        print(name + ": " + str(i));
        tick();
    }
}

fn start(name: string) {
    run {
        counter(name);
    } handle sched {
        ctl tick() { pending.push(() => { resume; }); }
    }
}

start("A");
start("B");

while (pending.len() > 0) {
    var next = pending[0];
    pending = pending[1:];
    next();
}
