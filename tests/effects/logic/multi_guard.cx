effect logic {
    ctl choose(options: Array<int>): int;
    ctl guard(cond: bool): unit;
}

handler logic_handler : logic {
    ctl choose(options) {
        for (x in options) {
            resume x;
        }
    }

    ctl guard(cond) {
        if (cond) {
            resume;
        }
    }
}

// Every value in the first list that also appears in the second.
var results: List<int> = [];
run {
    var num1 = choose([1, 2, 3, 4, 5]);
    var num2 = choose([3, 5, 7]);
    guard(num1 == num2);
    results.push(num1);
} with logic_handler;

print("Collect All Results:");
for (x in results) {
    print(x);
}

print("Find First Result:");
print(results[0]);
