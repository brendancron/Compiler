// An operation called in a condition rather than in a statement. Hoisting it
// into a `var` first is the same program and works today, so the two have to
// agree.
effect Ask { ctl get(): int; }

fn f(): <Ask> int {
    if (get() > 3) { return 1; } else { return 0; }
}

run {
    print(f());
} handle Ask {
    ctl get() {
        resume 5;
        print("after");
    }
}
