effect log {
    fn emit(msg: string): unit;
}

effect ask {
    fn base(): int;
}

fn traced<T, E>(label: string, f: () -> <E> T): <log, E> T {
    emit("enter " + label);
    var result = f();
    emit("leave " + label);
    return result;
}

fn quiet(): int {
    return 7;
}

fn asks(): <ask> int {
    return base() + 1;
}

run {
    print(str(traced("quiet", quiet)));
    print(str(traced("asks", asks)));
} handle log {
    fn emit(msg) { print("log: " + msg); }
} handle ask {
    fn base() { return 41; }
}
