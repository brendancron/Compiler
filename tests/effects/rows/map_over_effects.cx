effect log {
    fn emit(msg: string): unit;
}

effect ask {
    fn base(): int;
}

fn map<T, U, E>(items: List<T>, f: (T) -> <E> U): <E> List<U> {
    var out: List<U> = [];
    for (item in items) { out.push(f(item)); }
    return out;
}

fn show(xs: List<int>) {
    print(str(xs[0]) + " " + str(xs[1]) + " " + str(xs[2]));
}

fn double(x: int): int {
    return x * 2;
}

fn noted(x: int): <log> int {
    emit("saw " + str(x));
    return x + 1;
}

fn shifted(x: int): <ask, log> int {
    emit("shifting " + str(x));
    return x + base();
}

show(map([1, 2, 3], double));

run {
    show(map([1, 2, 3], noted));
    show(map([1, 2, 3], shifted));
} handle log {
    fn emit(msg) { print("log: " + msg); }
} handle ask {
    fn base() { return 10; }
}
