effect E { ctl op(): int; }

fn doubled() -> <E> int { return op() * 2; }
fn tripled() -> <E> int { return op() * 3; }

run {
    var tasks: List<() -> <E> int> = [];
    tasks.push(() => { return doubled(); });
    tasks.push(() => { return tripled(); });
    for (task in tasks) {
        print(str(task()));
    }
} handle E {
    ctl op() { resume 7; }
}
