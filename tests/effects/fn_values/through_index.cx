effect E { ctl op(): int; }

fn work(base: int): <E> int { return base + op(); }

var tasks: List<() -> <E> int> = [];
var pending: List<() -> unit> = [];

run {
    tasks.push(() => { return work(10); });
    print(str(tasks[0]()));
} handle E {
    ctl op() { pending.push { resume 5; }; }
}

print("draining");
pending[0]();
