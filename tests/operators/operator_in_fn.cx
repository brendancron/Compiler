class Vec2(x: Int, y: Int)

impl Add for Vec2 {
    fn add(other: Vec2): Vec2 {
        return Vec2(this.x + other.x, this.y + other.y);
    }
}

fn translate(v: Vec2, dx: Int, dy: Int): Vec2 {
    var offset = Vec2(dx, dy);
    return v + offset;
}

var start = Vec2(1, 2);
var moved = translate(start, 5, 7);
print(moved.x);
print(moved.y);
