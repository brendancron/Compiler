type Vec2 {
    x: int,
    y: int
}

op +(a: Vec2, b: Vec2) -> Vec2 {
        return new Vec2 { x: a.x + b.x, y: a.y + b.y };
}

fn translate(v: Vec2, dx: int, dy: int): Vec2 {
    var offset = new Vec2 { x: dx, y: dy };
    return v + offset;
}

var start = new Vec2 { x: 1, y: 2 };
var moved = translate(start, 5, 7);
print(moved.x);
print(moved.y);
