type Vec2 {
    x: int,
    y: int
}

impl Add<Vec2> for Vec2 {
    type Output = Vec2;

    fn add(self, rhs: Vec2): Vec2 {
        return new Vec2 { x: self.x + rhs.x, y: self.y + rhs.y };
    }
}

var v1 = new Vec2 { x: 1, y: 1 };
var v2 = new Vec2 { x: 1, y: 1 };
var v3 = new Vec2 { x: 1, y: 1 };
var result = v1 + v2 + v3;
print(result.x);
print(result.y);
