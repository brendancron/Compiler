// A row names effects, not operations: `log` and `yield` are both `mixed`,
// so calling either puts that one effect in the row.

effect mixed {
    fn log(msg: string): unit;
    ctl yield(i: int): unit;
}

fn produce(n: int) {
    log("start");
    yield(n);
    log("end");
}

print(typeof(produce).name);
