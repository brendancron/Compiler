// Only what reflection describes gets a shape of its own; the rest says so.
fn kind(shape: TypeShape) -> string {
    match shape {
        TypeShape::Scalar => { return "scalar"; }
        TypeShape::Product(name, fields) => { return "product"; }
        TypeShape::Sum(name, variants) => { return "sum"; }
        TypeShape::Other => { return "other"; }
    }
}

print(kind(typeof(1).shape), kind(typeof(1.5).shape), kind(typeof(true).shape));
print(kind(typeof("s").shape), kind(typeof('c').shape));
print(kind(typeof([1, 2]).shape), kind(typeof((1, 2)).shape), kind(typeof(kind).shape));
